running = True
empty_reads = 0

while running:
  cmd = socket_read_line("pc", timeout=2)

  if cmd == "":
    # Nothing arrived. Pause so the loop never runs at full speed.
    sleep(0.1)
    empty_reads = empty_reads + 1

    # A healthy, idle connection gives about one empty read per 2 s.
    # A dead connection gives them back to back. 100 in a row without
    # any command means the PC is gone or silent for a long time.
    if empty_reads >= 100:
      textmsg("No contact with PC, stopping")
      running = False
    end

  else:
    empty_reads = 0
    textmsg("Command: ", cmd)
    values = socket_read_ascii_float(12, "pc", timeout=5)

    if values[0] != 12:
      textmsg("No valid poses for command: ", cmd)
      socket_send_line("ERR", "pc")

    else:
      pose  = p[values[1], values[2], values[3], values[4], values[5], values[6]]
      pose2 = p[values[7], values[8], values[9], values[10], values[11], values[12]]

      if cmd == "HIT":
        HIT(pose)
        socket_send_line("DONE", "pc")

      elif cmd == "SPLIT":
        SPLIT(pose, pose2)
        socket_send_line("DONE", "pc")

      elif cmd == "REVEAL":
        REVEAL()
        socket_send_line("DONE", "pc")

      elif cmd == "DEALER_HIT":
        DEALER_HIT()
        socket_send_line("DONE", "pc")

      elif cmd == "DEALER_FACEDOWN":
        DEALER_FACEDOWN()
        socket_send_line("DONE", "pc")

      elif cmd == "QUIT":
        running = False
        socket_send_line("BYE", "pc")

      else:
        textmsg("Unknown command: ", cmd)
        socket_send_line("ERR", "pc")
      end
    end
  end
end

socket_close("pc")
textmsg("Program finished")