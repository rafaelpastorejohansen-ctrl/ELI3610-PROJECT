kort_timeout = 180.0

def show_funk():
  if not socket_send_line("READY", hoved_socket):
    textmsg("Kortleser: Kunne ikke sende READY")
    halt
  end

  kort_svar = socket_read_string(hoved_socket, suffix="\n", interpret_escape=True, timeout=kort_timeout)

  if kort_svar != "REGISTERED":
    textmsg("Kortleser: Mangler REGISTERED. Svar: ", kort_svar)
    halt
  end
end